### Node
# Dependencies
node_modules/

# Local pnpm content-addressed store (pinned in-repo via storeDir in
# pnpm-workspace.yaml)
.pnpm-store/

# Logs
*.log

# Runtime data
*.pid
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output

# Test runner artifacts
test-results/
playwright-report/

# Build output
dist/
dist-ssr/
build/Release

# Vite
.vite/
*.timestamp-*
*.local

# TypeScript cache
*.tsbuildinfo

# Rust / Tauri build output
target/
# Tauri generated ACL/state schemas. NOTE: a pattern that contains a slash
# is anchored to THIS .gitignore's directory (repo root), so it must be
# glob-prefixed to reach apps/editor/src-tauri/gen/ (the same trap the
# slash-less "target/" rule already avoids — bare names match at any depth).
**/src-tauri/gen/

# ESLint cache
.eslint-cache
.eslintcache

# Framework build output and caches
.cache
.parcel-cache
.next
out/
.nuxt

# dotenv environment variable files
.env
.env.local
.env.*.local

# npm cache directory
.npm
*.tgz

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*

### Windows
# Windows thumbnail cache files
Thumbs.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

### VS Code
# VSCode settings (keep shared configuration)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix
# Local review qualification output
.review-evidence/
