{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GGLab Shader Graph Editor",
  "version": "0.1.0",
  "identifier": "io.gglab.shadergraph.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GGLab Shader Graph Editor",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
